# Server
PORT=4000

# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/poster-maker

# Auth
JWT_SECRET=replace-with-a-long-random-string

# Gemini (used ONLY for layout/styling suggestions, never final text rendering)
GEMINI_API_KEY=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# CORS - the deployed/dev frontend origin
FRONTEND_ORIGIN=http://localhost:3000
